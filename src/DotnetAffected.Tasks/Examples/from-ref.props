<Project Sdk="DotnetAffected.Tasks/3.0.0;Microsoft.Build.Traversal/3.2.0">
    <Target Name="_DotnetAffectedCheck" AfterTargets="DotnetAffectedCheck">
        <PropertyGroup>
            <!-- The other end of the comparison is always the working directory, since that is
                 where projects are discovered and evaluated from. Only the baseline is named. -->
            <DotnetAffectedFromRef>3a3266abbed43690112ba42198109b9a7862a634d</DotnetAffectedFromRef>

            <!-- How much of the working directory counts on top of the commits since FromRef.
                 One of 'All' (the default), 'Staged' or 'None'. -->
            <DotnetAffectedUncommitted>None</DotnetAffectedUncommitted>
        </PropertyGroup>
    </Target>
</Project>
